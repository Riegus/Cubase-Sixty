// Version information: Windows shows FileDescription as the app's name (notifications, Task Manager).
#include <winver.h>

// The app icon (19.11.2026): the tray icon's design (TrayApp.cpp, makeIcon) in its "live" green, 16-256 px, made by
// cubase\tools\make-app-icon.py. The first icon in the file is the one Windows shows for the program (Explorer, the
// Start menu, Apps & features, notifications).
1 ICON "CubaseSixty.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Geir Sveen"
            VALUE "FileDescription", "Cubase-Sixty"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "CubaseSixty"
            VALUE "OriginalFilename", "CubaseSixty.exe"
            VALUE "ProductName", "Cubase-Sixty"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
