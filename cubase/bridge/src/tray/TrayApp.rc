// Version information: Windows shows FileDescription as the app's name (notifications, Task Manager).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Geir Sveen"
            VALUE "FileDescription", "Cubase-Sixty"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "CubaseSixty"
            VALUE "OriginalFilename", "CubaseSixty.exe"
            VALUE "ProductName", "Cubase-Sixty"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
